# The online netplay lobby of the SSBU native port (tools/ssbu_relay.py), as a systemd service.
# Installed by tools/deploy/deploy_lobby.sh; runs as a throwaway user with no write access anywhere.
[Unit]
Description=SSBU native port netplay lobby
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/ssbu-lobby/ssbu_relay.py --bind 0.0.0.0 --port 39420 --banlist /etc/ssbu-lobby/banlist.txt
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadOnlyPaths=/etc/ssbu-lobby
MemoryMax=256M
CPUQuota=100%
TasksMax=16
# (the statistics line comes once a minute; this only stops a flood of errors filling the disk)
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
