# The online lobby of the SSBU native port with the game's own Online mode (Quickplay):
# tools/ssbu_online_lobby.py, which is tools/ssbu_relay.py's lobby plus the NEX game server of
# tools/nex. Installed by tools/deploy/deploy_online_lobby.sh, next to (not instead of) the
# plain lobby's ssbu-lobby.service; runs as a throwaway user that can write only its state
# directory (players' accounts and ratings).
[Unit]
Description=SSBU native port online lobby (Quickplay)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/ssbu-online/ssbu_online_lobby.py --bind 0.0.0.0 --port 39421 --banlist /etc/ssbu-lobby/banlist.txt --state /var/lib/ssbu-online --nex-log 1
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
DynamicUser=yes
StateDirectory=ssbu-online
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadOnlyPaths=/etc/ssbu-lobby
MemoryMax=256M
CPUQuota=100%
TasksMax=16
# (each player's game keeps up to 4 NEX streams open; the lobby caps them at 2048 and connections
# still saying whose they are at 64)
LimitNOFILE=4096
# (the statistics line comes once a minute and the game server logs each call; this only stops a
# flood of errors filling the disk)
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
